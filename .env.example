# Copy to .env.local and adjust. NEXT_PUBLIC_* values are inlined at build time,
# so each environment needs its own build.

# REST base (must include /api/v1) and WebSocket base (must include /ws/v1).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/v1

# Production example:
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# NEXT_PUBLIC_WS_URL=wss://api.example.com/ws/v1

# Diagnostics panel on the room page (peer, ICE and DataChannel internals).
NEXT_PUBLIC_DEBUG=false

# Enables the /dev/benchmark page.
NEXT_PUBLIC_ENABLE_BENCHMARK=false

# The Android app (APK) download. Files over 100 MB can't go through git or Vercel, so host
# the APK elsewhere (e.g. a GitHub release asset, Cloudflare R2 or Google Drive) and put its
# URL here. A Google Drive share link works as is ("Anyone with the link" must be able to
# view): it is turned into a direct download, so users never see the Drive page.
# Without it, production hides the download; development serves public/app/Droply.apk.
# NEXT_PUBLIC_ANDROID_APK_URL=https://github.com/<you>/<repo>/releases/download/v1.0.0/Droply.apk
# NEXT_PUBLIC_ANDROID_APP_VERSION=1.0.0
# NEXT_PUBLIC_ANDROID_APK_SIZE=189 MB
# NEXT_PUBLIC_ANDROID_APK_SHA256=

# Unfinished transfers this device keeps open on the server at once (backend limit is 20).
NEXT_PUBLIC_MAX_ACTIVE_TRANSFERS=16
