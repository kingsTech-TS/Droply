# Copy to .env.local and adjust. NEXT_PUBLIC_* values are inlined at build time,
# so each environment needs its own build.

# REST base (must include /api/v1) and WebSocket base (must include /ws/v1).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/v1

# Production example:
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# NEXT_PUBLIC_WS_URL=wss://api.example.com/ws/v1

# Diagnostics panel on the room page (peer, ICE and DataChannel internals).
NEXT_PUBLIC_DEBUG=false

# Enables the /dev/benchmark page.
NEXT_PUBLIC_ENABLE_BENCHMARK=false

# Unfinished transfers this device keeps open on the server at once (backend limit is 20).
NEXT_PUBLIC_MAX_ACTIVE_TRANSFERS=16
